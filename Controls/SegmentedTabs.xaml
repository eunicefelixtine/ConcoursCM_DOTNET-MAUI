<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ConcoursCM.Controls.SegmentedTabs">
    <Border Style="{StaticResource SoftBox}" Padding="4" StrokeShape="RoundRectangle 16">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
            <Border x:Name="LeftBox" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,12">
                <Label x:Name="LeftLabel" HorizontalOptions="Center" FontAttributes="Bold" FontSize="14" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLeft" /></Border.GestureRecognizers>
            </Border>
            <Border x:Name="RightBox" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,12">
                <Label x:Name="RightLabel" HorizontalOptions="Center" FontAttributes="Bold" FontSize="14" />
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRight" /></Border.GestureRecognizers>
            </Border>
        </Grid>
    </Border>
</ContentView>

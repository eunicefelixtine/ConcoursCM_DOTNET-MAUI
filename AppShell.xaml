<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ConcoursCM.Views"
       x:Class="ConcoursCM.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False">

    <!-- Écran de connexion : point d'entrée -->
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Navigation principale (barre du bas) -->
    <TabBar Route="main">
        <ShellContent Title="Accueil" Route="home" ContentTemplate="{DataTemplate views:HomePage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="🏠" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Concours" Route="concours" ContentTemplate="{DataTemplate views:ConcoursListPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="🎓" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Bourses" Route="bourses" ContentTemplate="{DataTemplate views:BourseListPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="🏅" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Profil" Route="profil" ContentTemplate="{DataTemplate views:ProfilPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="👤" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>

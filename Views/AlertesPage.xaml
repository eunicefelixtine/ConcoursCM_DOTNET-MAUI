<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ctl="clr-namespace:ConcoursCM.Controls" xmlns:vm="clr-namespace:ConcoursCM.ViewModels" x:Class="ConcoursCM.Views.AlertesPage" Title="Alertes">
    <Grid RowDefinitions="Auto,*">
        <ctl:TopBar Title="Alertes" ShowBack="True" ShowBell="False" AvatarText="{Binding Avatar}" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="Centre d'Alertes" Style="{StaticResource H2}" FontSize="20" />
                    <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 99" Padding="8,2" VerticalOptions="Center">
                        <Label Text="{Binding NbNonLus}" TextColor="White" FontAttributes="Bold" FontSize="12" />
                    </Border>
                    <Label Grid.Column="2" Text="✓✓ Tout marquer comme lu" Style="{StaticResource Link}" FontSize="12" VerticalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ToutMarquerLuCommand}" /></Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 14">
                                <Grid ColumnDefinitions="5,*">
                                    <BoxView BackgroundColor="{Binding Accent}" Color="{Binding Accent}" />
                                    <VerticalStackLayout Grid.Column="1" Padding="12" Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border WidthRequest="40" HeightRequest="40" Style="{StaticResource SoftBox}" BackgroundColor="{Binding IconBg}" Padding="0" VerticalOptions="Start">
                                                <Label Text="{Binding Icone}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Border Style="{StaticResource Badge}" BackgroundColor="{Binding BadgeBg}" Padding="8,2">
                                                        <Label Text="{Binding Badge}" TextColor="{Binding Accent}" Style="{StaticResource BadgeText}" FontSize="10" />
                                                    </Border>
                                                    <Label Text="●" TextColor="{StaticResource Danger}" FontSize="10" IsVisible="{Binding NonLu}" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Titre}" FontAttributes="Bold" FontSize="15" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding Temps}" Style="{StaticResource Muted}" FontSize="11" VerticalOptions="Start" />
                                        </Grid>
                                        <Label Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="12" />
                                        <BoxView HeightRequest="1" Color="{StaticResource StrokeLight}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding PiedTexte}" Style="{StaticResource Muted}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding ActionLibelle, StringFormat='{0} →'}" Style="{StaticResource Link}" FontSize="12" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlertesViewModel}}, Path=OuvrirCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Aucune alerte pour le moment. Suivez un concours ou ajoutez-le en favori pour recevoir des rappels." Style="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" IsVisible="{Binding Vide}" Margin="0,30" />

                <Border Style="{StaticResource SoftBox}" Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Text="⚙" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Préférences de rappels (SMS &amp; Push)" FontAttributes="Bold" FontSize="13" />
                                <Label Text="Personnaliser vos seuils J-7, J-3, J-1" Style="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding PrefsVisibles}">
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Rappel à J-7" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding Rappel7}" /></Grid>
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Rappel à J-3" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding Rappel3}" /></Grid>
                            <Grid ColumnDefinitions="*,Auto"><Label Text="Rappel à J-1" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding Rappel1}" /></Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding BasculerPrefsCommand}" /></Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
